#!/usr/bin/env bash
# Lightweight secret scan on staged changes — no external dependency (no
# gitleaks/detect-secrets binary required), so it runs on every clone with
# zero setup beyond `npm install` (see the "prepare" script in package.json,
# which points git at this directory via `git config core.hooksPath`).
#
# This is intentionally pattern-based rather than entropy-based: entropy
# scanners routinely false-positive on this repo's own public identifiers
# (Supabase anon/publishable keys, Turnstile site keys, Sentry DSNs — all
# meant to ship in the client bundle by design, see src/supabase.js and
# src/utils/turnstile.js). Pattern matching on the *shape* of known private
# credential formats avoids that noise.

set -euo pipefail

staged_files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged_files" ] && exit 0

found=0
patterns=(
  '-----BEGIN[A-Z ]*PRIVATE KEY-----'
  'sk_live_[0-9a-zA-Z]{20,}'                    # Stripe secret key
  'AKIA[0-9A-Z]{16}'                             # AWS access key ID
  'AIza[0-9A-Za-z_-]{35}'                        # Google API key
  'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9\.[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}'  # raw JWT (service_role keys are JWTs)
  'SUPABASE_SERVICE_ROLE_KEY[[:space:]]*[:=][[:space:]]*["\x27][^"\x27]{20,}'
  '(SECRET|PRIVATE)_KEY[[:space:]]*[:=][[:space:]]*["\x27][^"\x27]{8,}'
  '[A-Z_]*PASSWORD[[:space:]]*[:=][[:space:]]*["\x27][^"\x27]{4,}'
)

for f in $staged_files; do
  [ -f "$f" ] || continue
  case "$f" in
    *.png|*.jpg|*.jpeg|*.gif|*.webp|*.ico|*.woff*|package-lock.json) continue ;;
  esac
  for p in "${patterns[@]}"; do
    if git diff --cached -U0 -- "$f" | grep -E -q -e "$p"; then
      echo "pre-commit: possible secret matching /$p/ in $f — review before committing." >&2
      found=1
    fi
  done
done

if [ "$found" -ne 0 ]; then
  echo "" >&2
  echo "Blocked. If this is a false positive (a public key/id that's meant to be committed)," >&2
  echo "re-run the commit with 'git commit --no-verify' after double-checking the value." >&2
  exit 1
fi
exit 0
